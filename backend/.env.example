# Secrets and machine-specific values. Copy to .env and fill in. Never commit .env.
DATABASE_URL=
INTERNAL_KEY=
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_STT_MODEL=
OLLAMA_URL=
OLLAMA_MODEL=
OFFLINE_MODE=
MEDIA_DIR=media
STREAM_SECRET=
# demo PINs for python -m app.seed, e.g. anita=1111,vikram=2222,ravi=3333,suresh=4444
DEMO_USER_PINS=
# demo phone roster for python -m app.seed (E.164; on a Twilio trial, verified numbers only), e.g. anita=+919800000001,ravi=+919800000003
DEMO_RESPONDER_PHONES=
# only dialled when a person orders it on the laptop assistant and says yes
FIRE_STATION_NUMBER=
SITE_ADDRESS=
# PPE (helmet/vest) and fire/smoke models: leave empty until a model with a clear licence is chosen
PPE_MODEL_PATH=
FIRE_MODEL_PATH=
# auto = live when the keys above are set, otherwise off; simulate = pretend (for demos without Twilio/WhatsApp)
CALLS_MODE=auto
WHATSAPP_MODE=auto
# someone with a dashboard open gets this long to react on screen before their phone rings
ONSCREEN_GRACE_S=5

# Config values (not secrets). Defaults are in app/config.py; uncomment to override.
# NIGHT_START=20:00
# NIGHT_END=06:00
# TIMEZONE=Asia/Kolkata
# DIGEST_TIME=18:00
# HEARTBEAT_TIMEOUT_S=30
# STREAM_TOKEN_TTL_S=3600
# YOLO_MODEL_PATH=models/yolo11n-pose.pt
# SESSION_TTL_H=12
# LOGIN_MAX_FAILURES=5
# PREFER_OPENVINO=true

# --- invitations by email (P19) ---
# Where invitation links and QR codes point: the laptop's dashboard address (on the hotspot, use its IP).
DASHBOARD_URL=
INVITE_TTL_H=48
# auto = live when SMTP_HOST and SMTP_FROM are set, else off; simulate = log only; off = share links by hand
EMAIL_MODE=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- guard details, badges and presence (P21) ---
# Encrypts guard personal details (badge number, badge ID, security number, emergency contact).
# Generate once and keep it safe; if you lose it, the stored details cannot be read again:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_KEY=
# A badge scan this recent covers an entry into its area; presence looks this far back from the chosen time
BADGE_WINDOW_S=300
PRESENCE_WINDOW_S=900

# --- wake word (voice, Step 1) ---
WAKE_MODEL=hey_jarvis_v0.1
WAKE_THRESHOLD=0.5
WAKE_COOLDOWN_S=2.0
# microphone number or name from: python -m voice.run_listener --list-devices (empty = default)
WAKE_DEVICE=
WAKE_ACK_SOUND=media/ack/yes_boss.wav

# --- cameras added from the dashboard (P22) ---
# true: the API starts a worker for every enabled camera when it boots and restarts crashed ones
WORKERS_AUTOSTART=false
WORKER_RESTART_S=30
STAFF_ID_PREFIX=RG

# --- duty check-in (P23) ---
# only these roles check in; off duty = not called. A check-in older than DUTY_MAX_H hours stops counting.
DUTY_ROLES=Head Guard,Guard
DUTY_MAX_H=16

# --- Rumik Silk voice (assistant replies) ---
# key and gateway address from the Rumik dashboard (playground.rumik.ai). Check them with: python -m tools.check_rumik
RUMIK_API_KEY=
RUMIK_GATEWAY_URL=
RUMIK_MODEL=muga
RUMIK_SPEAKER=

# --- Friday's wake-word listener (python -m voice.run_listener) ---
# the listener acts as this user (their name exactly as in People), e.g. Anita Rao
FRIDAY_USER=
VOICE_SILENCE_S=1.0
VOICE_MAX_S=12
VOICE_START_TIMEOUT_S=5
VOICE_SILENCE_RMS=500
